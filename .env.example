# Database Configuration (current Prisma provider: SQLite)
# This path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# DIRECT_URL is only needed after migrating the Prisma provider to PostgreSQL.
# DIRECT_URL="postgresql://user:password@hostname/dbname?sslmode=require"

# Next Auth Configuration
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Configuration (Can be set via Dashboard, but these are for initial setup)
# GOOGLE_GENERATIVE_AI_API_KEY="" 
